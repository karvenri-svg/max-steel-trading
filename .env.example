# ============================================================
#  Max Steel Trading — configuración (copia a .env y rellena)
#  NUNCA subas el archivo .env a git.
# ============================================================

# --- Base de datos ---
# SQLite para empezar (archivo local). Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/maxsteel
DATABASE_URL=sqlite:///./data/maxsteel.db

# --- Claude (Anthropic) ---
# Consíguela en https://console.anthropic.com -> API Keys
# Si la dejas vacía, el sistema funciona en "modo sin IA" con reglas locales.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Nivel de esfuerzo: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Reintento automático en otro modelo si Claude rechaza una petición (recomendado)
CLAUDE_FALLBACKS=true

# --- Telegram (notificaciones) ---
# 1) Habla con @BotFather -> /newbot -> copia el token
# 2) Envía un mensaje a tu bot y visita
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- eBay (API oficial Browse) ---
# https://developer.ebay.com -> Application Keys (Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Mercado de eBay: EBAY_US, EBAY_ES, EBAY_GB, ...
EBAY_MARKETPLACE=EBAY_US

# --- Mercado Libre (API oficial) ---
# https://developers.mercadolibre.com -> crea una aplicación
# Sitio: MLM (México), MLA (Argentina), MCO (Colombia), MLC (Chile), MPE (Perú)...
MELI_SITE_ID=MLM
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Token OAuth del usuario (se obtiene con el flujo de autorización de tu app)
MELI_ACCESS_TOKEN=

# --- Negocio ---
MONEDA=MXN
# Para convertir precios de eBay u otras monedas: USD=18.5,EUR=20
TIPOS_CAMBIO=USD=18.0
PRESUPUESTO_MAXIMO=1500
PUNTUACION_MINIMA_ALERTA=70
# Comisión estimada de venta (0.13 = 13%) y costo de envío promedio
COMISION_VENTA=0.13
COSTO_ENVIO=120
# Cada cuántos minutos busca ofertas el agente Buscador
INTERVALO_BUSQUEDA_MIN=30

# --- Panel web ---
# Usuario/clave para entrar al panel (déjalos vacíos solo en tu computadora)
PANEL_USUARIO=admin
PANEL_CLAVE=cambia-esta-clave
